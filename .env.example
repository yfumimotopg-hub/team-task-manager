# Copy to .env and fill in values. .env is git-ignored and must not be committed.
# Used by docker-compose.yml (db service) and the backend container.

# PostgreSQL container initialization (dev database).
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Backend application DB connection.
# Format: postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
DATABASE_URL=

# Backend test DB connection. Must point at the <POSTGRES_DB>_test database,
# never the dev database.
# Format: postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>_test
TEST_DATABASE_URL=
